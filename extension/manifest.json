{
  "manifest_version": 3,
  "name": "SpecTest — unit tests from copied code, API tests from contracts",
  "short_name": "SpecTest",
  "version": "0.2.0",
  "description": "Writes tests for code you copy or upload, on your computer with Chrome's built-in AI, and API tests from OpenAPI contracts.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SpecTest",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Open SpecTest"
    }
  },
  "permissions": [
    "activeTab",
    "clipboardRead",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
