{
  "manifest_version": 3,
  "name": "SpecTest — API tests from your OpenAPI contract",
  "short_name": "SpecTest",
  "version": "0.1.0",
  "description": "Turns an OpenAPI or Swagger document into runnable API contract tests, in the language your project uses.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SpecTest",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
